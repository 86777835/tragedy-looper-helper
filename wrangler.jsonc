{
  // Worker name, KV namespace id and custom domain are placeholders until deployment is decided (see README).
  "name": "tragedy-looper-helper",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-28",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "ratelimits": [{ "name": "CHAT_LIMIT", "namespace_id": "1013", "simple": { "limit": 8, "period": 60 } }],
  "ai": { "binding": "AI" },
  "kv_namespaces": [{ "binding": "CHAT_STATE", "id": "00000000000000000000000000000000" }],
  "triggers": { "crons": ["0 * * * *"] },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true }
}
